{
  "manifest_version": 3,
  "name": "ChatGPT Agents Tab Manager",
  "version": "0.5.0",
  "description": "Run autonomous ChatGPT browser agents, read-only app audits, and tab-recorded tutorial guides.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "sidePanel",
    "debugger",
    "activeTab",
    "tabCapture",
    "offscreen",
    "downloads"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "action": {
    "default_title": "Open ChatGPT Agents"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/content/chatgpt-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "116"
}
